# ===== 数据库 =====
# 本地开发（SQLite）：Prisma 的相对路径以 prisma/ 目录为基准
DATABASE_URL="file:./dev.db"
# 生产（PostgreSQL，docker compose 会自动注入，无需手动配置）：
# DATABASE_URL=postgresql://promptpilot:<密码>@db:5432/promptpilot?schema=public

# ===== 模型服务 =====
MODEL_API_URL=https://api.siliconflow.cn/v1
MODEL_NAME=deepseek-ai/DeepSeek-V3
# 必填（生产）：模型服务密钥，切勿提交到仓库
MODEL_API_KEY=

# ===== 接口限制（可选） =====
# 输入最大长度（字符）
MAX_INPUT_LENGTH=4000
# 每分钟优化请求上限
RATE_LIMIT_PER_MINUTE=20
